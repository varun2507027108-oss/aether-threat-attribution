# Backend Environment Configuration
AETHER_API_KEY=aether-investigator-dev-key-2026
AETHER_REQUIRE_AUTH=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
DATABASE_URL=sqlite:///./aether_dev.db
MAX_PAYLOAD_BYTES=2097152
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_INVESTIGATE_PER_MINUTE=10
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# Custody Chain Signing & RFC 3161 Checkpoints (Phase 2)
AETHER_SIGNING_KEY=
AETHER_SIGNING_PUBLIC_KEY=
AETHER_CHECKPOINT_INTERVAL=10
AETHER_TSA_URL=

# Tor Transport & Investigator OPSEC (Phase 3)
# In docker-compose, defaults to socks5://tor:9050. Unset locally for zero-config dev.
AETHER_TOR_SOCKS_URL=
AETHER_ACTIVE_PROBE_ENABLED=false
TOR_SOCKS_PROXY=

# Parallel Pipeline Execution & Module Timeout (Phase 4)
AETHER_MODULE_TIMEOUT=45

# Intel Source Mode (Phase 5)
# live = query Shodan/Censys using the API keys above.
# mock = serve deterministic fixtures from aether-backend/tests/fixtures/intel/.
# Unset resolves to live when SHODAN_API_KEY is present, otherwise mock.
AETHER_INTEL_MODE=
# Override the offline fixture directory (defaults to the in-repo test corpus).
AETHER_INTEL_FIXTURES_DIR=

# Calibrated Scoring Engine (Phase 6)
# Base rate that an investigated subject is the attributed actor, as numerator:denominator.
AETHER_PRIOR_ODDS=1:9
# Dempster-Shafer conflict mass above which a case is flagged as self-contradicting.
AETHER_CONFLICT_THRESHOLD=0.6
# Conflict mass above which the posterior starts being discounted, below the hard threshold.
AETHER_ELEVATED_CONFLICT_FLOOR=0.35
